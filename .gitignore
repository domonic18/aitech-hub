# 密钥与环境(严禁入库)
.secret/
.env
.env.*
!.env.example

# 本仓库的 .md 是交付物(docs/ 设计文档、CLAUDE.md、README),覆盖全局 ~/.gitignore_global 的 *.md 规则
!*.md

# 依赖与构建产物
node_modules/
.next/
dist/
worker-dist/
coverage/

# 系统与日志
.DS_Store
*.log

# 迁移产物与媒体(不入库)
/media/
scripts/migrate-wp/artifacts/
*.tsbuildinfo

# Playwright 本地产物
/test-results/
/playwright-report/

# App Router 字面段目录名含 .txt,被全局 gitignore *.txt 误伤,强制纳管
!src/app/llms.txt/
!src/app/llms-full.txt/
