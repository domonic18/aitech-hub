# 密钥与环境(严禁入库)
.secret/
.env
.env.*
!.env.example

# 本仓库的 .md 是交付物(docs/ 设计文档、CLAUDE.md、README),覆盖全局 ~/.gitignore_global 的 *.md 规则
!*.md

# 依赖与构建产物
node_modules/
.next/
dist/
coverage/

# vditor 运行时懒加载资源随库分发(lute WASM/i18n/图标/高亮/预览主题,内网可用);
# 反向规则覆盖上方 dist/ 与全局 ~/.gitignore_global 的 *.png 等
!/public/vditor/
!/public/vditor/dist/
!/public/vditor/dist/**

# 系统与日志
.DS_Store
*.log

# 运行时持久化数据(库/Redis/迁移媒体/证书,不入库;backups 见下方白名单)
# !/workspace/ 与 !/workspace/backups/ 用于覆盖全局 ~/.gitignore_global 的 workspace 规则
/workspace/*
!/workspace/
scripts/migrate-wp/artifacts/
*.tsbuildinfo

# 备份目录保留占位(M6 pg_dump cron 落盘处)
!/workspace/backups/
!/workspace/backups/.gitkeep

# Playwright 本地产物
/.test-results/
/playwright-report/

# cc-connect 消息桥运行时数据(会话附件等,不入库)
/.cc-connect/

# App Router 字面段目录名含 .txt,被全局 gitignore *.txt 误伤,强制纳管
!src/app/llms.txt/
!src/app/llms-full.txt/

# Next.js 自动生成,不追踪(新克隆由 next dev/build 生成;typecheck 实测不依赖)
/next-env.d.ts

# douyin-gateway(Python venv 与字节码;镜像内由 pip 现装)
/douyin-gateway/.venv/
__pycache__/
*.pyc

# douyin-gateway 依赖清单(全局 *.txt 误伤;CI gateway job 与镜像构建依赖)
!douyin-gateway/requirements.txt
!douyin-gateway/requirements-dev.txt
