# 密钥与环境(严禁入库)
.secret/
.env
.env.*
!.env.example

# 本仓库的 .md 是交付物(docs/ 设计文档、CLAUDE.md、README),覆盖全局 ~/.gitignore_global 的 *.md 规则
!*.md

# 依赖与构建产物
node_modules/
.next/
dist/
coverage/

# vditor 运行时懒加载资源随库分发(lute WASM/i18n/图标/高亮/预览主题,内网可用);
# 反向规则覆盖上方 dist/ 与全局 ~/.gitignore_global 的 *.png 等
!/public/vditor/
!/public/vditor/dist/
!/public/vditor/dist/**

# 品牌 favicon/apple-icon 资产入库(覆盖全局 ~/.gitignore_global 的 *.png)
!src/app/apple-icon.png

# 系统与日志
.DS_Store
*.log

# 运行时持久化数据(库/Redis/迁移媒体/证书,不入库;backups 见下方白名单)
# !/workspace/ 与 !/workspace/backups/ 用于覆盖全局 ~/.gitignore_global 的 workspace 规则
/workspace/*
!/workspace/
*.tsbuildinfo

# 备份目录保留占位(M6 pg_dump cron 落盘处);包体档案不入库,目录仅留 .gitkeep
!/workspace/backups/
!/workspace/backups/.gitkeep
workspace/backups/*.tgz
workspace/backups/db/

# Playwright 本地产物
/.test-results/
/playwright-report/

# cc-connect 消息桥运行时数据(会话附件等,不入库)
/.cc-connect/

# App Router 字面段目录名含 .txt,被全局 gitignore *.txt 误伤,强制纳管
!src/app/llms.txt/
!src/app/llms-full.txt/

# Next.js 自动生成,不追踪(新克隆由 next dev/build 生成;typecheck 实测不依赖)
/next-env.d.ts

# douyin-gateway(Python venv 与字节码;镜像内由 pip 现装)
/services/douyin-gateway/.venv/
__pycache__/
*.pyc

# douyin-gateway 依赖清单(全局 *.txt 误伤;CI gateway job 与镜像构建依赖)
!services/douyin-gateway/requirements.txt
!services/douyin-gateway/requirements-dev.txt

# 搜索引擎验证文件(全局 *.txt 误伤;public/ 静态资产本就全部纳管)
!public/*.txt
