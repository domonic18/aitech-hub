{
  "name": "aitech-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "sh scripts/build-with-info.sh",
    "start": "next start -p 3000",
    "worker": "tsx --env-file=.env worker/index.ts",
    "worker:build": "tsc -p tsconfig.worker.json && tsc-alias -p tsconfig.worker.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test",
    "test:e2e": "playwright test",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "admin": "tsx scripts/admin.ts",
    "qa:acceptance": "tsx --env-file=.env scripts/qa/acceptance.ts",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.25",
    "@assistant-ui/react-langgraph": "^0.14.33",
    "@langchain/anthropic": "^1.5.12",
    "@langchain/langgraph": "^1.4.19",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/langgraph-sdk": "^1.12.1",
    "@langchain/openai": "^1.6.2",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.10",
    "cheerio": "^1.2.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "deepagents": "^1.14.2",
    "fast-xml-parser": "^5.11.2",
    "ffmpeg-static": "^5.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "markdown-it": "^14.3.2",
    "mysql2": "^3.24.4",
    "next": "15.5.26",
    "pg": "^8.23.0",
    "pino": "^10.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-easy-crop": "^6.2.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vditor": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
