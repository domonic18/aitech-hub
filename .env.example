# ── 应用 ─────────────────────────────────────────────
NODE_ENV=development
# 站点对外 URL(canonical/sitemap/metadataBase 基准)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 媒体目录(迁移媒体落地位;相对 process.cwd() 解析,dev 指向 workspace/ 持久化约定)
# 生产容器由 docker-compose.prod.yml 的 x-app-env 覆盖为 /app/media(挂载 ./workspace/media)
MEDIA_DIR=workspace/media

# ── 数据与缓存(dev compose:pg 5434 / redis 6380)────
DATABASE_URL=postgresql://aitech:aitech@localhost:5434/aitech_hub?schema=public&connection_limit=5
REDIS_URL=redis://localhost:6380/0

# ── 生产 compose(仅 docker-compose.prod.yml 插值用)──
# prod postgres 容器口令;web/worker 的 DATABASE_URL 由 compose 据此拼出(容器网内 postgres:5432)
POSTGRES_PASSWORD=

# ── 会话 ─────────────────────────────────────────────
# jose 签名密钥;make setup 自动生成,生产部署必配(openssl rand -base64 32)。
# 同时派生应用密钥箱主密钥(Cookie 池/模型 API Key 加密,M8 批⑥);
# 轮换会使已存密文失效,需重导 Cookie、重录模型 API Key。
AUTH_SECRET=

# ── 腾讯云短信(三期用户短信登录启用前可留空)─────────
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=

# ── WP 迁移(仅 scripts/migrate-wp;生产用只读账号+隧道)──
# 本地:经 wp_mysql_fwd 容器把 wp_mysql:3306 转发到宿主 13306
MIGRATE_SOURCE_URL=
# 源 uploads 树(默认 ../17aitech/wordpress_data/wp-content/uploads,可覆盖)
MIGRATE_UPLOADS_DIR=

# ── 抖音视频采集(M8;dev compose --profile douyin 起 douyin-gateway)──
DOUYIN_GATEWAY_URL=http://127.0.0.1:8010

# ── GitHub 项目展示(M11;可选令牌)────────────────────
# 空=未认证 API(60 req/h):白名单 ≤10 仓×每轮 4 请求×60min 周期约 40 req/h 贴上限;
# 建议配 PAT(仅公开仓读权限即可)提升至 5000/h。密钥仅 env,不入库不打日志。
GITHUB_TOKEN=

# 视频解读日配额不在 env:后台 /admin/models 任务绑定 interpret 卡设置(M9,
# 存 ai_task_binding.daily_max,缺省 100)

# ── 腾讯云 COS(M19:媒体存储 + 数据库备份异机存放)──────
# 存储后端:local=本地卷(缺省,dev 零依赖);cos=COS(CosProvider,URL 不变 nginx 反代)
MEDIA_STORAGE=local
# 密钥仅 env 不入库不打日志;子账号最小权限(媒体桶公有读私有写,备份桶私有读写)
COS_SECRET_ID=
COS_SECRET_KEY=
# 地域,如 ap-guangzhou(与生产服务器同地域走内网)
COS_REGION=
# 媒体桶(MEDIA_STORAGE=cos 必配;name-appid 全称)
COS_MEDIA_BUCKET=
# 媒体桶公网域名(<bucket>.cos.<region>.myqcloud.com,不含 https://;仅生产 nginx
# 反代用,M19 批④ 模板注入,缺失则生产栈起不来;本机 dev 不需要)
COS_MEDIA_HOST=
# 备份桶(db-backup 每日 03:23 pg_dump 上传;30 天 lifecycle 由 scripts/cos-setup 设置)
COS_BACKUP_BUCKET=

# 事务邮件 SMTP(M21 批⓪)不入 env:admin 后台「邮件配置」页维护,
# 存数据库 email_config 表(用户拍板,与支付域同规则)。

# 支付域(M21 批②)不入 env:支付模式(off|mock|xunhu,即总闸)+ 网关
# 凭据 + 回调地址 + 关单 TTL 全部存 pay_gateway_config 表,admin 后台
# 「支付配置」页唯一维护(2026-10-08/09 两次拍板);mock 模式仅开发环境可选。
