# ── 应用 ─────────────────────────────────────────────
NODE_ENV=development
# 站点对外 URL(canonical/sitemap/metadataBase 基准)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 媒体目录(迁移媒体落地位;相对 process.cwd() 解析,dev 指向 workspace/ 持久化约定)
# 生产容器由 docker-compose.prod.yml 的 x-app-env 覆盖为 /app/media(挂载 ./workspace/media)
MEDIA_DIR=workspace/media

# ── 数据与缓存(dev compose:pg 5434 / redis 6380)────
DATABASE_URL=postgresql://aitech:aitech@localhost:5434/aitech_hub?schema=public&connection_limit=5
REDIS_URL=redis://localhost:6380/0

# ── 生产 compose(仅 docker-compose.prod.yml 插值用)──
# prod postgres 容器口令;web/worker 的 DATABASE_URL 由 compose 据此拼出(容器网内 postgres:5432)
POSTGRES_PASSWORD=

# ── 会话 ─────────────────────────────────────────────
# jose 签名密钥;make setup 自动生成,生产部署必配(openssl rand -base64 32)
AUTH_SECRET=

# ── 腾讯云短信(三期用户短信登录启用前可留空)─────────
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=

# ── WP 迁移(仅 scripts/migrate-wp;生产用只读账号+隧道)──
# 本地:经 wp_mysql_fwd 容器把 wp_mysql:3306 转发到宿主 13306
MIGRATE_SOURCE_URL=
# 源 uploads 树(默认 ../17aitech/wordpress_data/wp-content/uploads,可覆盖)
MIGRATE_UPLOADS_DIR=

# ── 抖音视频采集(M8;dev compose --profile douyin 起 douyin-gateway)──
DOUYIN_GATEWAY_URL=http://127.0.0.1:8010
# Cookie 池加密密钥(openssl rand -base64 32;留空=admin 导入禁用)
APP_COOKIE_ENC_KEY=
