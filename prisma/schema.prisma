// aitech-hub 数据模型(docs/arch/03-data-model.md 为设计真相源)
// 规则:模型 PascalCase + @@map snake 表名;字段 camelCase + @map snake 列名。
// 禁止 prisma db push;schema 变更只经 prisma/migrations(forward-only)。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── content_(内容域)─────────────────────────────────────────────

/// 文章主表;wpPostId 是与旧站的溯源锚点
model Post {
  id              BigInt    @id @default(autoincrement())
  slug            String?   @unique(map: "uq_content_post_slug") @db.VarChar(255) // 装饰性 ASCII slug(可空可改;URL 由 id 锚定 /post/<id>-<slug>,2026-10 迁移自 percent-encoded 中文)
  title           String    @db.VarChar(500)
  excerpt         String?   @db.Text
  contentHtml     String?   @map("content_html") @db.Text // 旧文正文(清洗后 HTML,只读保真)
  contentMd       String?   @map("content_md") @db.Text // 新文正文(Markdown;与 html 二选一非空)
  coverPath       String?   @map("cover_path") @db.VarChar(500)
  categoryId      BigInt    @map("category_id")
  status          String    @default("draft") @db.VarChar(20) // draft/published/deleted(软删;下架=回 draft 保留 published_at;合法值应用层 Zod 管控,arch/03 枚举演进条款)
  contentOrigin   String    @default("human") @map("content_origin") @db.VarChar(20) // 创作方式:human/ai_assisted/ai_generated(AI 生成内容显式标识,2026-10-05 合规;合法值应用层枚举,见 content/post-schema)
  isPinned        Boolean   @default(false) @map("is_pinned")
  viewsCount      BigInt    @default(0) @map("views_count")
  isPurchasable   Boolean   @default(false) @map("is_purchasable") // M21 批①:付费解锁开关
  purchasePrice   Decimal?  @map("purchase_price") @db.Decimal(10, 2) // M21 批①:解锁价 CNY(仅 isPurchasable 时有意义)
  isLoginRequired Boolean   @default(false) @map("is_login_required") // M21 补齐批:登录可见(仿旧站 unlock_type=1;与付费互斥,应用层校验)
  seoTitle        String?   @map("seo_title") @db.VarChar(255)
  seoDescription  String?   @map("seo_description") @db.Text
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  wpPostId        BigInt?   @unique(map: "uq_content_post_wp_post_id") @map("wp_post_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category    Category             @relation(fields: [categoryId], references: [id])
  tags        PostTag[]
  viewDays    StatsPostViewDaily[]
  mediaRefs   MediaRef[]
  githubRepos GithubRepoPost[]
  channels    PublishChannel[]
  comments    PostComment[]
  likes       PostLike[]

  @@index([status, publishedAt(sort: Desc)], map: "idx_content_post_status_published")
  @@index([categoryId], map: "idx_content_post_category")
  @@map("content_post")
}

model Category {
  id          BigInt   @id @default(autoincrement())
  slug        String   @unique(map: "uq_content_category_slug") @db.VarChar(100) // blog / report / news / advertising
  name        String   @db.VarChar(100)
  description String?  @db.Text
  // 原创分类标记(2026-10-20 验收反馈:首页按「博主文章/推荐视频」分流;
  // 文章随分类继承——blog/report=true,推荐视频/资讯/推广=false,后台可改)
  isOriginal  Boolean  @default(false) @map("is_original")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  posts Post[]

  @@map("content_category")
}

model Tag {
  id        BigInt   @id @default(autoincrement())
  slug      String   @unique(map: "uq_content_tag_slug") @db.VarChar(200)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  posts PostTag[]

  @@map("content_tag")
}

/// 显式多对多(arch/03-data-model §3:不用隐式 m2m,保 SQL 可控)
model PostTag {
  postId BigInt @map("post_id")
  tagId  BigInt @map("tag_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("content_post_tag")
}

/// 媒体统一资产(图片+视频+文件;kind 现在就位,二期视频零迁移)
model Media {
  id              BigInt    @id @default(autoincrement())
  path            String    @unique(map: "uq_content_media_path") @db.VarChar(500) // URL 路径;/wp-content/uploads/... 或 /media/videos/...
  filename        String    @db.VarChar(255)
  kind            String    @default("image") @db.VarChar(20) // image/video/file
  status          String    @default("active") @db.VarChar(20) // active/orphan/missing/processing/error/deleted(应用层 Zod 管控,arch/03 枚举演进条款)
  sizeBytes       BigInt?   @map("size_bytes")
  width           Int?
  height          Int?
  durationSeconds Int?      @map("duration_seconds") // 视频用;图片 NULL
  thumbPath       String?   @map("thumb_path") @db.VarChar(500)
  sha1            String?   @db.Char(40) // 重复检测与去重;未软删行唯一约束 uq_content_media_sha1(批⑦ partial unique,Prisma 不表达,见迁移 20261013120000——全列唯一与回收站软删留档语义互斥)
  storage         String    @default("local") @db.VarChar(20) // local/cos(arch/08-media 演进)
  wpAttachmentId  BigInt?   @map("wp_attachment_id")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6) // 软删回收站:7 天后 audit 任务物理删除(arch/08-media §3.2)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([kind, status], map: "idx_content_media_kind_status")
  @@map("content_media")
}

/// 媒体引用追踪:文章保存时解析正文/封面写入;孤儿/断链清洗的地基(arch/08-media §3)
model MediaRef {
  mediaPath String @map("media_path") @db.VarChar(500)
  postId    BigInt @map("post_id")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([mediaPath, postId])
  @@index([postId], map: "idx_content_media_ref_post")
  @@map("content_media_ref")
}

/// 文章评论(M23;先发后审:无 pending 态,新发即 visible,治理=隐藏/恢复)。
/// 仅登录用户可评论;userId 无 FK(账号删除留档,feedback 同纪律),authorName
/// 为写侧快照(登录=nickname,迁移=WP 原名),渲染零 join。parentId 自引用无 FK,
/// 应用层两级封顶(子回复一律挂根 id),删根连带直接子由 service 事务显式收集。
/// wpCommentId 为旧站 wp_comments 迁移幂等键(legacy-comments oneoff 脚本)。
model PostComment {
  id          BigInt   @id @default(autoincrement())
  postId      BigInt   @map("post_id")
  userId      BigInt?  @map("user_id")
  authorName  String   @map("author_name") @db.VarChar(100)
  content     String   @db.VarChar(4000) // 列宽 4000 容旧站迁移实测 max 2143(dry-run 2026-10-10);新提交 zod 限 1..1000
  status      String   @default("visible") @db.VarChar(16) // visible | hidden(应用层 Zod 管控)
  parentId    BigInt?  @map("parent_id") // 自引用无 FK:两级封顶由应用层校验(仅挂根)
  wpCommentId BigInt?  @unique(map: "uq_content_post_comment_wp_comment_id") @map("wp_comment_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  post  Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes PostCommentLike[]

  @@index([postId, status, createdAt], map: "idx_content_post_comment_post_visible")
  @@index([status, createdAt(sort: Desc)], map: "idx_content_post_comment_status_recent")
  @@map("content_post_comment")
}

/// 文章点赞(M23):游客可赞;identityKey 单列去重("u:<userId>" | "v:<ah_av uuid>"),
/// 不用 (userId?, visitorId?) 双列——PG unique 中 NULL 互不判重,双列拦不住游客
/// 重复赞。不加冗余计数列:计数由 API 现查 COUNT(arch/03 决策注记)。
model PostLike {
  postId      BigInt   @map("post_id")
  identityKey String   @map("identity_key") @db.VarChar(42)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, identityKey], map: "uq_content_post_like_post_identity")
  @@map("content_post_like")
}

/// 评论点赞(M23):与 PostLike 同构;commentId FK Cascade 随评论收尸。
model PostCommentLike {
  commentId   BigInt   @map("comment_id")
  identityKey String   @map("identity_key") @db.VarChar(42)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, identityKey], map: "uq_content_post_comment_like_comment_identity")
  @@map("content_post_comment_like")
}

// ── user_(账号域)───────────────────────────────────────────────

model UserAccount {
  id               BigInt    @id @default(autoincrement())
  phone            String?   @unique(map: "uq_user_account_phone") @db.VarChar(20)
  username         String?   @unique(map: "uq_user_account_username") @db.VarChar(100) // M21 批⓪:邮箱注册用户名,登录标识之一
  email            String?   @unique(map: "uq_user_account_email") @db.VarChar(255) // M21 批⓪:邮箱通道(D1)
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(6)
  nickname         String?   @db.VarChar(100)
  avatarPath       String?   @map("avatar_path") @db.VarChar(500)
  bio              String?   @db.VarChar(500)
  assistantVisible Boolean   @default(true) @map("assistant_visible") // M22:悬浮助手 FAB 显隐(账号级,跨设备;游客走 localStorage)
  role             String    @default("user") @db.VarChar(20) // user/admin
  status           String    @default("active") @db.VarChar(20) // active/disabled/pending_binding
  passwordHash     String?   @map("password_hash") @db.VarChar(255) // 可空,自愿补设(bcrypt)
  wpUserId         BigInt?   @unique(map: "uq_user_account_wp_user_id") @map("wp_user_id")
  legacyUsername   String?   @map("legacy_username") @db.VarChar(100)
  legacyPhpass     String?   @map("legacy_phpass") @db.VarChar(255) // 仅审计留存,登录永不使用
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  pats               UserPat[]
  verificationTokens UserVerificationToken[]
  tokenWallet        UserTokenWallet?
  tokenLedger        UserTokenLedger[]

  @@index([status], map: "idx_user_account_status")
  @@map("user_account")
}

/// 发布 API 个人访问令牌(requirement §3.6):库中只存 sha256 哈希,可吊销
model UserPat {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  name       String    @db.VarChar(100) // 令牌备注(如 "claude-code-laptop")
  tokenHash  String    @unique(map: "uq_user_pat_token_hash") @map("token_hash") @db.Char(64)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_user_pat_user")
  @@map("user_pat")
}

/// 邮箱通道一次性令牌(M21 批⓪,D1):注册认证/绑定邮箱/找回密码共用;
/// 库中只存 sha256,原始令牌仅出现在邮件链接里;单次消费 + TTL 过期
model UserVerificationToken {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  purpose    String    @db.VarChar(20) // register_verify | bind_email | password_reset
  tokenHash  String    @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose], map: "idx_user_verification_token_user_purpose")
  @@map("user_verification_token")
}

/// 事务邮件 SMTP 配置(M21 批⓪;用户拍板 2026-10-08:入数据库 admin 后台
/// 维护,不入 env——与支付网关凭据同规则)。单行语义:代码恒读首行,admin
/// 保存整行覆盖。password 同 pay_gateway_config 纪律:API 读侧永不回传,
/// 表单留空 = 保留原值;不入日志。enabled=false 时发送显式跳过(可存配置
/// 暂停发送)。from 用 from_addr 列名(FROM 为 SQL 保留字)。
model EmailConfig {
  id        BigInt   @id @default(autoincrement())
  host      String   @db.VarChar(255)
  port      Int      @default(465) // 465 走 implicit TLS,其余 STARTTLS
  username  String   @db.VarChar(255)
  password  String   @db.VarChar(255)
  fromAddr  String   @map("from_addr") @db.VarChar(255) // 如 "一起AI <noreply@17aitech.com>"
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("email_config")
}

// ── pay_(支付域,M21 批①,提案 §4;arch/03 §2.4 补记)──────────────

/// 支付订单(M21):状态机 pending→paid/closed→refunded 显式迁移(提案 §5.2,
/// 只允许图中迁移);金额全程 Decimal 禁 float;orderNo 下单生成幂等键。
/// userId 不设 FK(支付域与账号域解耦,应用层归属校验)。
model PayOrder {
  id                   BigInt    @id @default(autoincrement())
  orderNo              String    @unique(map: "uq_pay_order_order_no") @map("order_no") @db.VarChar(32)
  userId               BigInt    @map("user_id")
  status               String    @db.VarChar(16) // pending | paid | closed | refunded(显式状态机,应用层 Zod 管控)
  amount               Decimal   @db.Decimal(10, 2) // CNY,字符串化处理,禁 float
  gateway              String    @db.VarChar(24) // xunhu | mock | legacy_xunhu(历史导入)
  gatewayTransactionId String?   @map("gateway_transaction_id") @db.VarChar(64) // 微信流水,索引级对账锚点(旧系统缺失项)
  gatewayOpenOrderId   String?   @map("gateway_open_order_id") @db.VarChar(64) // 虎皮椒内部单号
  paidAt               DateTime? @map("paid_at") @db.Timestamptz(6)
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)
  refundedAt           DateTime? @map("refunded_at") @db.Timestamptz(6)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6) // pending 超时关单依据(下单+30min)
  clientIp             String?   @map("client_ip") @db.VarChar(45)
  operatorNote         String?   @map("operator_note") @db.VarChar(200) // 人工/导入场景备注
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  items PayOrderItem[]

  @@index([userId, status], map: "idx_pay_order_user_status")
  @@index([status, expiresAt], map: "idx_pay_order_status_expires") // 对账 job 扫描路径
  @@map("pay_order")
}

/// 订单行(M21):一文一单;标题/单价为下单时快照(防文章后续改名改价追溯失真)
model PayOrderItem {
  id        BigInt  @id @default(autoincrement())
  orderId   BigInt  @map("order_id")
  postId    BigInt  @map("post_id")
  title     String  @db.VarChar(200) // 下单时文章标题快照
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  quantity  Int     @default(1)

  order PayOrder @relation(fields: [orderId], references: [id])

  @@index([postId], map: "idx_pay_order_item_post_id")
  @@map("pay_order_item")
}

/// 付费权益(M21):一文一用户一条,授予=upsert revokedAt=null;
/// 软撤销(退款 CD 回调)审计可恢复;orderId 仅 order 来源必有,import/manual 可空
model ContentPostPurchase {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  postId        BigInt    @map("post_id")
  orderId       BigInt?   @map("order_id") // order 来源指向订单;import/manual/admin_restore 可空
  source        String    @db.VarChar(16) // order | import | manual | admin_restore(应用层枚举)
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6) // 软撤销(退款 CD 回调),审计可恢复
  revokedReason String?   @map("revoked_reason") @db.VarChar(200)

  @@unique([userId, postId], map: "uq_content_post_purchase_user_post")
  @@index([postId], map: "idx_content_post_purchase_post_id")
  @@map("content_post_purchase")
}

/// 网关回调留痕(M21):含被拒回调全量落库(可追溯伪造尝试,安全清单 #5);
/// 回调原文不含密钥字段,可全量存
model PayNotifyLog {
  id            BigInt   @id @default(autoincrement())
  orderNo       String   @map("order_no") @db.VarChar(32)
  gatewayStatus String   @map("gateway_status") @db.VarChar(8) // OD/WP/CD/RD/UD
  signValid     Boolean  @map("sign_valid")
  payload       Json
  handled       Boolean  @default(false) // 是否触发状态迁移
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderNo], map: "idx_pay_notify_log_order_no")
  @@map("pay_notify_log")
}

/// 网关凭据 + 支付模式(M21,2026-10-08/09 拍板全部入数据库,env 无支付
/// 变量):admin 专属页唯一写入口,读取一律脱敏,明文不进日志/API 响应/git。
/// 支付模式落表形态:enabled=true 的行即当前生效网关(至多一行;全 false
/// = 收银台关闭);mock 行仅开发环境可启用(生产保存拒绝+运行时忽略)。
/// appSecret 密文列(M50 批E':e1: 前缀 AES-256-GCM 同列升级;旧行明文读兼容,
/// 下次保存转密;读侧 secret-box#readSecretCompat 双形态)
model PayGatewayConfig {
  id            BigInt   @id @default(autoincrement())
  gateway       String   @unique(map: "uq_pay_gateway_config_gateway") @db.VarChar(24) // xunhu | mock(仅开发)
  appId         String   @map("app_id") @db.VarChar(64)
  appSecret     String   @map("app_secret") @db.VarChar(255) // 密文/legacy 明文双形态(批E'),读取侧脱敏
  apiBase       String   @map("api_base") @db.VarChar(128) // 主用 https://api.dpweixin.com(2026-10-08 实证)
  apiBaseBackup String?  @map("api_base_backup") @db.VarChar(128) // 备用域,下单失败自动切换
  notifyUrl     String   @default("") @map("notify_url") @db.VarChar(500) // 异步回调(https 生产域名;空=未配置,下单前校验)
  returnUrl     String   @default("") @map("return_url") @db.VarChar(500) // 支付完成前端跳转(仅展示,不入账依据)
  orderTtlMin   Int      @default(30) @map("order_ttl_min") // pending 超时关单(分钟);无行时业务层回落 30
  enabled       Boolean  @default(false) // 生效网关标记:enabled=true 的行即当前支付模式(至多一行)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("pay_gateway_config")
}

// ── stats_(统计域)──────────────────────────────────────────────

/// 文章阅读数日明细(迁移自 wp_post_views;新浏览 UPSERT 日行 + 累加 views_count)
model StatsPostViewDaily {
  postId   BigInt   @map("post_id")
  viewDate DateTime @map("view_date") @db.Date
  count    BigInt   @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, viewDate])
  @@map("stats_post_view_daily")
}

/// GEO 机器面抓取:llms.txt 索引/llms-full 全文/文章 .md 直出 × 爬虫(2026-10-09 方案A;
/// middleware 对 GEO 路径不分名单内外一律上报,未识别 UA 记 unknown-agent)。
/// post_id 无外键:llms 两面以空串占位(空串不撞 NULL 语义的唯一键),文章名查询侧按 id 反解。
model StatsGeoDaily {
  statDate DateTime @map("stat_date") @db.Date
  surface  String   @db.VarChar(20) // llms_index/llms_full/post_md
  botName  String   @map("bot_name") @db.VarChar(50) // bots.ts 稳定名;unknown-agent=未识别 UA
  postId   String   @default("") @map("post_id") @db.VarChar(20) // 文章 BigInt id 文本;索引面空串
  pv       BigInt   @default(0)

  @@id([statDate, surface, botName, postId])
  @@map("stats_geo_daily")
}

/// 站点总览:全站 PV/UV(requirement §3.5;beacon 上报 → Redis 缓冲 → worker 聚合)
model StatsVisitDaily {
  statDate DateTime @id @map("stat_date") @db.Date
  pv       BigInt   @default(0)
  uv       BigInt   @default(0)

  @@map("stats_visit_daily")
}

/// 流量来源:direct/search/referral/ai 四类细分(requirement §3.5)
model StatsReferrerDaily {
  statDate    DateTime @map("stat_date") @db.Date
  sourceClass String   @map("source_class") @db.VarChar(20) // direct/search/referral/ai/bot(爬虫抓取,2026-10-07 方案B)
  sourceName  String   @map("source_name") @db.VarChar(50) // direct 固定 'none';其余 google/bing/chatgpt…/GPTBot…
  pv          BigInt   @default(0)
  uv          BigInt   @default(0)

  @@id([statDate, sourceClass, sourceName])
  @@map("stats_referrer_daily")
}

/// 热门页面:路径粒度(文章页同时累加 stats_post_view_daily)
model StatsPageDaily {
  statDate DateTime @map("stat_date") @db.Date
  path     String   @db.VarChar(500)
  pv       BigInt   @default(0)
  uv       BigInt   @default(0)

  @@id([statDate, path])
  @@index([statDate, pv(sort: Desc)], map: "idx_stats_page_daily_date_pv")
  @@map("stats_page_daily")
}

/// 访客环境(采集一期实现,展示可简版)
model StatsClientDaily {
  statDate   DateTime @map("stat_date") @db.Date
  browser    String   @db.VarChar(50)
  os         String   @db.VarChar(50)
  deviceType String   @map("device_type") @db.VarChar(20) // desktop/mobile/tablet
  pv         BigInt   @default(0)

  @@id([statDate, browser, os, deviceType])
  @@map("stats_client_daily")
}

/// 近期访问明细(M10 批⑥,页面行级):全量 IP 短留存(7 天,worker 日清过期行);
/// 访客身份仍是哈希(visitor_hash),明文 IP 仅作短留存排查用
model StatsVisitLog {
  id          BigInt   @id @default(autoincrement())
  path        String   @db.VarChar(500)
  ip          String   @db.VarChar(45) // IPv4/IPv6
  browser     String   @db.VarChar(50)
  os          String   @db.VarChar(50)
  deviceType  String   @map("device_type") @db.VarChar(20) // desktop/mobile/tablet
  sourceClass String   @map("source_class") @db.VarChar(20) // direct/search/referral/ai
  sourceName  String   @map("source_name") @db.VarChar(50)
  visitorHash String   @map("visitor_hash") @db.VarChar(32) // sha256(salt+ip+ua) 前 32 位,不可逆
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "idx_stats_visit_log_created_at")
  @@map("stats_visit_log")
}

/// 搜索词排行(2026-10-06 需求):/search 页 counted PV 的 q,行级直插不经缓冲;
/// 无 PII(不存 IP/访客哈希,排行不需要访客维度);180 天保留(worker 日清),排行「全部」窗口受此界
model StatsSearchLog {
  id        BigInt   @id @default(autoincrement())
  term      String   @db.VarChar(100) // 用户输入原文(trim + 空白折叠后截 100 字,不折叠大小写)
  hitCount  Int?     @map("hit_count") // 命中数(M34 批① 增强):null=增强前旧数据;0=零结果(内容缺口信号,洞察中心消费)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "idx_stats_search_log_created_at")
  @@map("stats_search_log")
}

/// 条目点击明细(M28 批①):首页/电报流条目点击行为统计,行级直插不经缓冲;
/// 无 PII(无 IP/无访客哈希,行为聚合不需要访客维度),循 stats_search_log 先例
/// 180 天保留(worker 日清)。ref 无外键:telegram/post 存 BigInt id 文本、
/// project 存冻结 slug,标题查询侧反解(删文/删条目 title 兜底占位)
model StatsClickLog {
  id        BigInt   @id @default(autoincrement())
  surface   String   @db.VarChar(20) // home/telegram(点击发生的页面)
  kind      String   @db.VarChar(20) // telegram/project/post(条目类型)
  ref       String   @db.VarChar(100) // 条目键:telegram/post=BigInt id 文本,project=slug
  domain    String   @default("") @db.VarChar(100) // 外链域名(服务端从 target 解析;站内链接空串)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "idx_stats_click_log_created_at")
  @@map("stats_click_log")
}

/// 混合检索语义向量(M20,arch/04 §3.2):三域内容 embedding(pgvector 余弦召回,
/// 与关键词计分 RRF 融合)。向量列类型 Prisma 不识别(Unsupported)——读写一律 raw SQL
/// (pgvector 文本序列化),本模型仅锚定 DDL 防 migrate 漂移;换 embedding 模型 =
/// dims/模型列不兼容,需新表或全量重嵌,届时报迁移评审
model SearchEmbedding {
  id         BigInt                      @id @default(autoincrement())
  entityType String                      @map("entity_type") @db.VarChar(20) // post/telegram/repo
  entityId   BigInt                      @map("entity_id")
  model      String                      @db.VarChar(100) // 生成模型 id(embedding-3);对账与灰度排查用
  dims       Int // 锁 1024(embedding-3 支持档 256/512/1024/2048 取衡)
  embedding  Unsupported("vector(1024)") // 读写走 raw SQL;client 不暴露
  updatedAt  DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([entityType, entityId], map: "search_embedding_entity_type_entity_id_key")
  @@map("search_embedding")
}

// ── legacy_(旧站承接域)─────────────────────────────────────────

/// 旧 URL 301 映射(迁移脚本灌入;legacy 路由 + Redis 缓存消费)
model LegacyUrlMap {
  oldPath    String   @id @map("old_path") @db.VarChar(500)
  targetUrl  String?  @map("target_url") @db.VarChar(500) // NULL → 410
  httpStatus Int      @default(301) @map("http_status") @db.SmallInt
  note       String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("legacy_url_map")
}

// ── telegram_(电报流/采集域,M7)────────────────────────────────

/// 采集渠道台账(arch/02 §2):频控与每日上限按渠道独立;
/// type=social-video 为平台行(M8:1 平台 1 行——Cookie 池 config/总开关/日上限,自身不调度)
model CrawlSource {
  id               Int       @id @default(autoincrement())
  name             String    @unique(map: "uq_crawl_source_name") @db.VarChar(100)
  type             String    @db.VarChar(20) // rss/api/web/social-video(合法值应用层 Zod 管控,arch/03 枚举演进条款)
  platform         String?   @db.VarChar(20) // douyin/xhs/bilibili(type=social-video 时)
  url              String    @db.VarChar(500) // feed/API 端点
  enabled          Boolean   @default(true)
  crawlIntervalMin Int       @default(30) @map("crawl_interval_min")
  dailyMaxRequests Int?      @map("daily_max_requests") // 每日请求上限,超限当日跳过;null=不限
  consecutiveFails Int       @default(0) @map("consecutive_fails") // 连续失败 ≥3 → status=error(arch/02 §3.1)
  lastRunAt        DateTime? @map("last_run_at") @db.Timestamptz(6)
  nextRunAt        DateTime? @map("next_run_at") @db.Timestamptz(6)
  status           String    @default("healthy") @db.VarChar(20) // healthy/degraded/error
  config           Json? // 渠道适配配置(type=api 存 {apiKey} 等;后台维护,展示脱敏、日志禁打,不入环境变量)
  remark           String?   @db.VarChar(200)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  telegrams      Telegram[]
  socialAccounts SocialAccount[]

  @@map("crawl_source")
}

/// 电报条目(1-3 句摘要 + 原文外链;独立于文章库,/telegram noindex;content_hash 全库去重锚)
model Telegram {
  id              BigInt    @id @default(autoincrement())
  sourceId        Int       @map("source_id")
  title           String?   @db.VarChar(500)
  summary         String    @db.VarChar(1000) // 1-3 句(一期规则截断,LLM 摘要后置开关)
  url             String    @db.VarChar(1000) // 原文外链(一律跳原站)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  contentHash     String    @unique(map: "uq_telegram_content_hash") @map("content_hash") @db.Char(40) // sha1(title+url 规范化)
  status          String    @default("visible") @db.VarChar(20) // visible/hidden/archived/deleted(软删)
  filterHit       String?   @map("filter_hit") @db.VarChar(200) // 命中的过滤规则/屏蔽词(命中默认不 visible)
  mediaType       String    @default("text") @map("media_type") @db.VarChar(10) // text/video(M8 混合流)
  // 视频字段组(media_type=video;解读列组见下——不设 transcript/play_url,版权红线 arch/02 §3.2)
  videoPlatform   String?   @map("video_platform") @db.VarChar(20) // douyin/xhs/bilibili
  videoBlogger    String?   @map("video_blogger") @db.VarChar(100) // 冗余博主名,博主删除不影响历史条目
  videoCoverUrl   String?   @map("video_cover_url") @db.VarChar(1000) // 封面缩略图
  videoDuration   Int?      @map("video_duration") // 秒
  videoEngagement Json?     @map("video_engagement") // {play,like,comment}
  // AI 解读列组(M9,interpreter 队列产物):仅持久化分析结论(topic/summary/points),
  // 转写文本是输入不是资产、play_url 不落库(临时音视频文件判读即删)
  aiStatus        String?   @map("ai_status") @db.VarChar(20) // null=未解读/pending/processing/done/missing_transcript/failed
  aiTopic         String?   @map("ai_topic") @db.VarChar(50)
  aiSummary       String?   @map("ai_summary") @db.VarChar(1000)
  aiPoints        Json?     @map("ai_points") // string[](≤3 条,应用层 Zod 管控)
  aiKeywords      Json?     @map("ai_keywords") // string[](3-5 个,M12 批⑥ 文字条关键词 tag;禁泛词)
  aiNote          String?   @map("ai_note") @db.Text // 解读笔记(M26):interpreter 二次调用产出的分析笔记 markdown;null=未产出/存量(转写即删红线不变,笔记是分析产物)
  aiRanAt         DateTime? @map("ai_ran_at") @db.Timestamptz(6)
  lastAiError     String?   @map("last_ai_error") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  source CrawlSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([status, publishedAt(sort: Desc)], map: "idx_telegram_status_published")
  @@index([sourceId, createdAt], map: "idx_telegram_source_created")
  @@index([status, mediaType], map: "idx_telegram_status_media")
  @@map("telegram")
}

/// 短视频博主台账(M8,arch/02 §2):平台级 Cookie 池与总开关/日上限在 crawl_source
/// 平台行(type=social-video,1 平台 1 行,N:1),本表持博主身份与逐博主调度/观测;
/// 删除两步武装(先停用再物理删;video_blogger 冗余隔离历史条目)
model SocialAccount {
  id               Int       @id @default(autoincrement())
  platformRowId    Int       @map("platform_row_id")
  platform         String    @db.VarChar(20) // douyin 首批(bilibili/xhs 后补)
  secUid           String    @map("sec_uid") @db.VarChar(100)
  nickname         String    @db.VarChar(100)
  avatarUrl        String?   @map("avatar_url") @db.VarChar(1000)
  category         String?   @db.VarChar(50)
  enabled          Boolean   @default(true)
  crawlIntervalMin Int       @default(180) @map("crawl_interval_min") // arch/02 §3.2:博主轮询 ≥120min
  lastPostAt       DateTime? @map("last_post_at") @db.Timestamptz(6) // 增量地板(只采更新)
  lastRunAt        DateTime? @map("last_run_at") @db.Timestamptz(6)
  nextRunAt        DateTime? @map("next_run_at") @db.Timestamptz(6)
  consecutiveFails Int       @default(0) @map("consecutive_fails")
  lastError        String?   @map("last_error") @db.VarChar(500)
  remark           String?   @db.VarChar(200)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  platformRow CrawlSource @relation(fields: [platformRowId], references: [id], onDelete: Restrict)

  @@unique([platform, secUid], map: "uq_social_account_platform_sec_uid")
  @@index([enabled, nextRunAt], map: "idx_social_account_due")
  @@index([platformRowId], map: "idx_social_account_platform_row")
  @@map("social_account")
}

/// 屏蔽词(命中即不入流;scope 限定匹配字段;回溯隐藏存量为后台手动操作)
model Blocklist {
  id        Int      @id @default(autoincrement())
  word      String   @unique(map: "uq_blocklist_word") @db.VarChar(100)
  scope     String   @default("all") @db.VarChar(10) // title/summary/all
  hitCount  Int      @default(0) @map("hit_count")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("blocklist")
}

// ── ai_(AI 服务治理域,M8 批⑥,arch/04 §4)──────────────────────────

/// LLM/生图模型台账(多行):API Key AES-256-GCM 密文落 api_key_enc
/// (主密钥由 AUTH_SECRET HKDF 派生,不入库),api_key_mask 冗余回显脱敏;
/// 主力/备用定位不在本表——ai_task_binding 按角色持有(默认/备用由绑定派生)
model AiModel {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(100)
  provider          String    @db.VarChar(20) // 自由串(DeepSeek/智谱 AI/其他…)
  protocol          String    @db.VarChar(20) // openai/anthropic/other,合法值应用层 Zod 管控
  baseUrl           String?   @map("base_url") @db.VarChar(500)
  modelId           String    @map("model_id") @db.VarChar(100)
  apiKeyEnc         String?   @map("api_key_enc") @db.VarChar(500) // base64(iv|tag|ct);null=无鉴权(内网网关)
  apiKeyMask        String?   @map("api_key_mask") @db.VarChar(20) // 脱敏回显冗余列,免解密
  purposes          String[] // interpret/summarize/search/cover,合法值应用层 Zod 管控
  supportsVision    Boolean   @default(false) @map("supports_vision")
  priceIn           Float?    @map("price_in") // 牌价 ¥/1M prompt tokens(null=不计费/未配置)
  priceOut          Float?    @map("price_out") // 牌价 ¥/1M completion tokens
  pricePerImage     Float?    @map("price_per_image") // 生图牌价 ¥/张(cover 角色)
  concurrency       Int       @default(4)
  timeoutSec        Int       @default(60) @map("timeout_sec")
  extraParams       Json?     @map("extra_params") // 供应商扩展参数(如生图 watermark_enabled),浅合并进请求体;保留键不可覆盖,生图保留键显式 null=剔除(严格校验供应商适配)
  enabled           Boolean   @default(true)
  lastTestedAt      DateTime? @map("last_tested_at") @db.Timestamptz(6)
  lastTestStatus    String?   @map("last_test_status") @db.VarChar(10) // ok/fail
  lastTestError     String?   @map("last_test_error") @db.VarChar(500)
  lastTestLatencyMs Int?      @map("last_test_latency_ms")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  primaryBindings AiTaskBinding[] @relation("AiBindingPrimary")
  backupBindings  AiTaskBinding[] @relation("AiBindingBackup")

  @@map("ai_model")
}

/// 任务绑定(四角色一行,role 自然主键;首访 upsert 补齐):
/// M9 消费方经 resolver 读本表解析主力→备用
model AiTaskBinding {
  role      String   @id @db.VarChar(20) // interpret/summarize/search/cover
  primaryId Int?     @map("primary_id")
  backupId  Int?     @map("backup_id")
  dailyMax  Int?     @map("daily_max") // 角色日配额(条/日;null=默认 100;interpret/summarize 各自消费,M9 后台可配)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  primary AiModel? @relation("AiBindingPrimary", fields: [primaryId], references: [id], onDelete: SetNull)
  backup  AiModel? @relation("AiBindingBackup", fields: [backupId], references: [id], onDelete: SetNull)

  @@map("ai_task_binding")
}

/// ASR 转写渠道(单例 id=1,get-or-create;apiKey 空=无鉴权)
model AsrConfig {
  id                Int       @id @default(1) // 单例锚点,应用层只允许 id=1
  provider          String    @db.VarChar(50)
  protocol          String    @db.VarChar(20) // openai/minimax/other,合法值应用层 Zod 管控
  baseUrl           String?   @map("base_url") @db.VarChar(500)
  modelId           String    @map("model_id") @db.VarChar(100)
  apiKeyEnc         String?   @map("api_key_enc") @db.VarChar(500)
  apiKeyMask        String?   @map("api_key_mask") @db.VarChar(20)
  maxAudioSeconds   Int       @default(600) @map("max_audio_seconds")
  pricePerHour      Float?    @map("price_per_hour") // ASR 牌价 ¥/小时音频(null=不计费/未配置)
  hotwords          String[]  @default([])
  enabled           Boolean   @default(false) // 默认关:先配置并测试通过后再开(消费方 M9)
  lastTestedAt      DateTime? @map("last_tested_at") @db.Timestamptz(6)
  lastTestStatus    String?   @map("last_test_status") @db.VarChar(10) // ok/fail
  lastTestError     String?   @map("last_test_error") @db.VarChar(500)
  lastTestLatencyMs Int?      @map("last_test_latency_ms")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("asr_config")
}

/// 文生图封面候选(M14 批⑥,验收反馈问题6):worker 生成入库(uploadMedia 走
/// sha1 去重 + sharp 缩略管线),编辑器凭 token 轮询选用。token=编辑器会话令牌
/// (创建态文章尚无 id,统一以 token 定位;编辑态回填 postId 供溯源)。
/// 候选不清洗:历史候选保留供回溯,媒体回收站承担删除语义(arch/08 §3.2)。
model CoverCandidate {
  id        BigInt   @id @default(autoincrement())
  token     String   @db.VarChar(64) // 编辑器生成会话令牌(crypto.randomUUID)
  postId    BigInt?  @map("post_id") // 编辑态回填;创建态 null
  prompt    String   @db.VarChar(1000)
  mediaPath String   @map("media_path") @db.VarChar(500)
  modelId   Int      @map("model_id") // ai_model.id(生图模型溯源)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([token], map: "idx_ai_cover_candidate_token")
  @@index([postId], map: "idx_ai_cover_candidate_post")
  @@map("ai_cover_candidate")
}

/// AI 用量台账(M14 批⑦,验收反馈问题8):chatJsonTask(LLM)/ASR 转写/生图
/// 三类调用逐次落行,status=degraded 记「切备用/降级」事件(原型降级次数 KPI)。
/// 聚合在 /admin/usage 读侧现算(行量=调用次数级);费用不落库,读侧按
/// ai_model.price_in/out(¥/1M tokens)、price_per_image(¥/张)、
/// asr_config.price_per_hour(¥/h)现折算——牌价改动即整体重算,预算参考口径。
/// 90 天保留:worker 每日清 + 后台手动清理(POST /api/usage/purge)。
model AiUsageLog {
  id           BigInt   @id @default(autoincrement())
  role         String   @db.VarChar(20) // interpret/summarize/search/cover/asr
  modelId      Int?     @map("model_id") // ai_model.id;asr 行 null(计费走 asr_config)
  modelKey     String   @map("model_key") @db.VarChar(100) // 展示用 model_id 文本
  tokensIn     Int      @default(0) @map("tokens_in")
  tokensOut    Int      @default(0) @map("tokens_out")
  audioSeconds Int      @default(0) @map("audio_seconds") // asr 行:转写音频秒
  durationMs   Int      @default(0) @map("duration_ms")
  status       String   @default("ok") @db.VarChar(10) // ok/degraded/failed
  sessionId    String?  @map("session_id") @db.VarChar(40) // K2.6:会话/线程锚(后台会话管理聚合口径;他类调用缺省)
  userId       BigInt?  @map("user_id") // M22:登录用户锚(悬浮助手 run 归属/个人消耗页;站点级调用缺省;无 FK,账号删除不回删台账)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_ai_usage_log_created")
  @@index([role, modelId], map: "idx_ai_usage_log_role_model")
  @@index([sessionId], map: "idx_ai_usage_log_session")
  @@index([userId, createdAt(sort: Desc)], map: "idx_ai_usage_log_user_created")
  @@map("ai_usage_log")
}

// ── ai_illu_(配图工坊,M40 批 B,arch/05 §4.7)──────────────────────
// 版本链/图层组/图层行三表:根版本=进入工坊的原始整图(generate_illustration
// 出图即登记,拆层仍纯手动——M40 决策);编辑回路确认后产新版本(parent 单链);
// 拆层一次运行=一个图层组(干净底板+透明 PNG 图层行)。spike 实证契约
// (2026-10-22,workspace/tmp/spike-illustration-studio/):底图=抠净元素的
// 干净底板(显隐组合导出语义成立,藏层即元素真消失);官方水印烙在底板上
// (导出恒带水印,合规自动闭环);图层=bbox 区域高分重提(纵横比与 bbox 一致、
// 尺寸非等比),合成按 normalized bbox 定位缩放。

/// 配图版本(版本链节点):mediaPath=该版本整图(站内媒体路径,编辑回路输入
/// 与产物);origin 记产生方式;edit_instruction/edit_bbox 记复现依据
/// (original 两列为 null)。name=展示名(登记时从提示词派生,链上随根;
/// NULL=历史行,展示兜底「配图 #id」);source=登记口('agent'|'studio',
/// NULL=历史行不显来源)。parent 单链不分支(评审史即链);不设删除
/// (版本不可变历史,M40 无删除面)。
model IllustrationVersion {
  id              BigInt   @id @default(autoincrement())
  mediaPath       String   @map("media_path") @db.VarChar(500)
  parentVersionId BigInt?  @map("parent_version_id")
  origin          String   @db.VarChar(20) // original/text_edit/erase/redraw
  name            String?  @db.VarChar(200) // 展示名(提示词派生前 40 字,链内继承)
  source          String?  @db.VarChar(20) // 登记口:agent(会话生图)/studio(工坊直出)
  editInstruction String?  @map("edit_instruction") @db.VarChar(1000) // 产生本版本的编辑指令
  editBbox        String?  @map("edit_bbox") @db.VarChar(40) // normalized "x1 y1 x2 y2"
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parent   IllustrationVersion?     @relation("illu_version_chain", fields: [parentVersionId], references: [id])
  children IllustrationVersion[]    @relation("illu_version_chain")
  groups   IllustrationLayerGroup[]

  @@index([parentVersionId], map: "idx_ai_illu_version_parent")
  @@index([mediaPath], map: "idx_ai_illu_version_media")
  @@map("ai_illu_version")
}

/// 图层组(一次拆层运行):version 维度手动触发;改字后旧组即过期(手动重拆
/// 产新组,旧组保留供回看)。status=processing 时编辑器轮询;ready 后 layers
/// 可用;failed 带人话 error。baseMediaPath=干净底板(data[0] 转存,合成
/// 与画布预览的背景层——非 version.mediaPath 整图)。
model IllustrationLayerGroup {
  id            BigInt   @id @default(autoincrement())
  versionId     BigInt   @map("version_id")
  baseMediaPath String?  @map("base_media_path") @db.VarChar(500) // 底板转存路径(ready 后非空)
  status        String   @default("processing") @db.VarChar(12) // processing/ready/failed
  error         String?  @db.VarChar(500)
  modelId       Int      @map("model_id") // ai_model.id(拆层调用溯源,与用量台账对账)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  version IllustrationVersion @relation(fields: [versionId], references: [id])
  layers  IllustrationLayer[]

  @@index([versionId, createdAt], map: "idx_ai_illu_group_version_created")
  @@map("ai_illu_layer_group")
}

/// 图层行(拆层产物单层):bbox=官方 normalized[0-999] x1/y1/x2/y2(合成定位
/// 唯一依据,spike 实证图层尺寸非等比必须按 bbox 缩放);mediaPath=透明 PNG
/// 站内转存路径(官方 URL 24h 过期前由 worker 转存);visible=显隐组合
/// (默认全显,导出在前端画布按 z 序合成底板+可见层)。
model IllustrationLayer {
  id          BigInt   @id @default(autoincrement())
  groupId     BigInt   @map("group_id")
  zIndex      Int      @map("z_index")
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(500)
  bboxX1      Int      @map("bbox_x1")
  bboxY1      Int      @map("bbox_y1")
  bboxX2      Int      @map("bbox_x2")
  bboxY2      Int      @map("bbox_y2")
  mediaPath   String   @map("media_path") @db.VarChar(500)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  group IllustrationLayerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, zIndex], map: "idx_ai_illu_layer_group_zindex")
  @@map("ai_illu_layer")
}

// ── content_pin(贴图域,M41 渠道三)──────────────────────────────

/// 贴图(渠道三主实体,「一文看懂XXX」轻图文):标题 ≤32 码点(公众号
/// newspic 硬上限,应用层 Zod)+ 轻文字纯文本(≤2 万码点,UI 软帽 2000)+
/// 有序图片列表(content_pin_image,引用配图工坊 ai_illu_version 不拷文件)+
/// 专题软关联。status 状态机:draft(草稿)→ pending(待验收)→ synced(已推
/// 公众号草稿箱)→ published(站点 /pins 上架);回退仅 pending→draft。
/// read_more_url 同步时写公众号 content_source_url(阅读原文回跳站内)。
/// crop_spec 为封面裁剪快照(cover_info.crop_percent_list,同步随 draft/add)。
model ContentPin {
  id                 BigInt    @id @default(autoincrement())
  title              String    @db.VarChar(64) // ≤32 码点(应用层 Zod;VarChar 留字节数余量)
  content            String    @default("") @map("content") @db.Text // 轻文字纯文本(禁 Markdown/内联 HTML)
  topicId            BigInt?   @map("topic_id") // 专题软关联(应用层完整性:删专题由编辑侧改挂)
  status             String    @default("draft") @db.VarChar(20) // draft/pending/synced/published(应用层 Zod)
  readMoreUrl        String?   @map("read_more_url") @db.VarChar(500)
  cropSpec           String    @default("1_1") @map("crop_spec") @db.VarChar(40) // 1_1/16_9/2.35_9
  referenceMediaPath String?   @map("reference_media_path") @db.VarChar(500) // 生图采纳的参照图(站内 uploads 路径,soft ref;缺省回落到创作样例图/素材封面)
  syncedAt           DateTime? @map("synced_at") @db.Timestamptz(6) // 最近一次公众号草稿同步成功
  publishedAt        DateTime? @map("published_at") @db.Timestamptz(6) // 站点 /pins 上架时间
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  images   ContentPinImage[]
  channels ContentPinChannel[]

  @@index([status, updatedAt(sort: Desc)], map: "idx_content_pin_status_updated")
  @@index([topicId, updatedAt(sort: Desc)], map: "idx_content_pin_topic_updated")
  @@map("content_pin")
}

/// 贴图有序图片:version_id 引用配图工坊版本(soft ref 应用层完整性,不拷
/// 文件不回写;本地上传为 null);media_path 为挂载时快照——工坊后续改字产
/// 新版本不篡改已挂序列,升版由人工在组装台重挂。首张即封面(公众号
/// image_list 顺序 = 本表 sort_order;站点瀑布流封面同源)。
model ContentPinImage {
  id        BigInt   @id @default(autoincrement())
  pinId     BigInt   @map("pin_id")
  versionId BigInt?  @map("version_id")
  mediaPath String   @map("media_path") @db.VarChar(500) // 站内路径(/wp-content/uploads/…)
  width     Int?
  height    Int?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pin ContentPin @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@index([pinId, sortOrder], map: "idx_content_pin_image_pin_sort")
  @@map("content_pin_image")
}

/// 贴图渠道留痕(循 publish_channel 同款):每贴图×渠道一行,(pin,channel)
/// 唯一;media_id=公众号草稿 media_id(draft/add newspic 回执,重推走
/// draft/update);publish_id 预留 freepublish 发表回执。失败可重试
/// (attempts/last_error 人话,同步管线落)。
model ContentPinChannel {
  id        BigInt    @id @default(autoincrement())
  pinId     BigInt    @map("pin_id")
  channel   String    @db.VarChar(20) // wechat(合法值应用层 Zod,arch/03 枚举演进条款)
  status    String    @default("pending") @db.VarChar(20) // pending/synced/failed(应用层 Zod)
  mediaId   String?   @map("media_id") @db.VarChar(100) // 公众号草稿 media_id
  publishId String?   @map("publish_id") @db.VarChar(100) // freepublish 回执(预留)
  attempts  Int       @default(0) @map("attempts")
  lastError String?   @map("last_error") @db.VarChar(500)
  syncedAt  DateTime? @map("synced_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  pin ContentPin @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@unique([pinId, channel], map: "uq_content_pin_channel_pin_channel")
  @@map("content_pin_channel")
}

// ── site_(站点配置域,M10)────────────────────────────────────────

/// 站点配置 kv(通用底座,后续设置键在此登记复用):value 一律字符串,
/// 消费方自行解析+clamp;键名合法值应用层 Zod 管控(同枚举字段纪律)。
/// value Text(M12 批②扩列:home.hero_md 存 markdown 文案,200 装不下)
model SiteConfig {
  key       String   @id @db.VarChar(50)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_config")
}

// ── github_(项目展示域,二期③/M11)───────────────────────────────

/// GitHub 仓库白名单台账(admin 逐行登记 owner/name,不做全账号扫描):
/// slug 登记时由 name 派生并冻结(GitHub 改名不影响站内 URL);同步/观测列族
/// 与 social_account 同款(间隔/连败/last_error/status);删除两步武装(先停用)
model GithubRepo {
  id               Int       @id @default(autoincrement())
  fullName         String    @unique(map: "uq_github_repo_full_name") @map("full_name") @db.VarChar(200) // owner/name(同步跟随 GitHub 改名重定向回写)
  slug             String    @unique(map: "uq_github_repo_slug") @db.VarChar(100) // 站内 URL 键 /projects/<slug>,登记时派生此后冻结
  description      String?   @db.VarChar(500)
  stars            Int       @default(0)
  forks            Int       @default(0)
  language         String?   @db.VarChar(50)
  topics           String[]  @default([])
  htmlUrl          String    @map("html_url") @db.VarChar(500)
  homepage         String?   @db.VarChar(500)
  defaultBranch    String    @default("main") @map("default_branch") @db.VarChar(100)
  // README 缓存(base64 解码后 md;渲染时相对链接按 fullName/defaultBranch 重写)
  readmeMd         String?   @map("readme_md") @db.Text
  readmeSha        String?   @map("readme_sha") @db.Char(40) // sha 不变跳写,防 updatedAt/sitemap lastmod 空转
  readmeFetchedAt  DateTime? @map("readme_fetched_at") @db.Timestamptz(6)
  // 展示与调度
  display          Boolean   @default(true) // 前台展示开关(下架不删数据)
  sortOrder        Int       @default(0) @map("sort_order") // 展示排序(小在前)
  enabled          Boolean   @default(true)
  syncIntervalMin  Int       @default(60) @map("sync_interval_min")
  lastSyncAt       DateTime? @map("last_sync_at") @db.Timestamptz(6)
  nextSyncAt       DateTime? @map("next_sync_at") @db.Timestamptz(6)
  consecutiveFails Int       @default(0) @map("consecutive_fails")
  lastError        String?   @map("last_error") @db.VarChar(500)
  status           String    @default("healthy") @db.VarChar(20) // healthy/degraded/error
  remark           String?   @db.VarChar(200)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  activities GithubRepoActivity[]
  posts      GithubRepoPost[]

  @@index([enabled, nextSyncAt], map: "idx_github_repo_due")
  @@map("github_repo")
}

/// 进展动态(最近提交/发布):同步 upsert(去重锚 repo_id+kind+external_id,
/// P2002 兜底并发),裁剪仅留每仓最新 GITHUB_ACTIVITY_KEEP 条
model GithubRepoActivity {
  id         BigInt   @id @default(autoincrement())
  repoId     Int      @map("repo_id")
  kind       String   @db.VarChar(20) // commit/release(合法值应用层 Zod 管控)
  externalId String   @map("external_id") @db.VarChar(100) // commit sha / release id
  title      String   @db.VarChar(500) // commit 首行 / release 名
  url        String?  @db.VarChar(500)
  author     String?  @db.VarChar(100)
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  repo GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, kind, externalId], map: "uq_github_repo_activity_repo_kind_ext")
  @@index([repoId, occurredAt(sort: Desc)], map: "idx_github_repo_activity_repo_occurred")
  @@map("github_repo_activity")
}

/// 仓库↔文章 显式多对多(admin 手动关联;「配套文章 ×N」与详情页联动;镜像 PostTag)
model GithubRepoPost {
  repoId Int    @map("repo_id")
  postId BigInt @map("post_id")

  repo GithubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)
  post Post       @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([repoId, postId])
  @@index([postId], map: "idx_github_repo_post_post")
  @@map("github_repo_post")
}

// ── publish_(分发域,二期⑤/M17;requirement §4 多渠道分发)─────────

/// 微信公众号渠道配置(单例 id=1,get-or-create;镜像 asr_config):
/// appSecret 经 secret-box AES-256-GCM 密文只写不读,界面仅回显掩码;
/// auto_sync_enabled=发布即自动推草稿(默认关,先配置并测试通过后手动开)
model WechatConfig {
  id                Int       @id @default(1) // 单例锚点,应用层只允许 id=1
  appid             String    @db.VarChar(50)
  appSecretEnc      String?   @map("app_secret_enc") @db.VarChar(500) // base64(iv|tag|ct);null=未录
  appSecretMask     String?   @map("app_secret_mask") @db.VarChar(20) // 脱敏回显冗余列
  author            String?   @db.VarChar(64) // 图文 author 字段(空=管道缺省「一起AI」)
  theme             String    @default("default") @db.VarChar(20) // 默认正文主题 id(wechat-themes 注册表;同步弹窗单篇可覆盖)
  paraStyle         String    @default("default") @map("para_style") @db.VarChar(20) // 段落排版(M51):default/indent/justify/indent_justify
  enableTocMeta     Boolean   @default(false) @map("enable_toc_meta") // 文首阅读时间+目录卡(M51)
  autoSyncEnabled   Boolean   @default(false) @map("auto_sync_enabled") // 发布即自动推草稿
  enabled           Boolean   @default(false) // 渠道总开关:配置并测试通过后再开
  lastTestedAt      DateTime? @map("last_tested_at") @db.Timestamptz(6)
  lastTestStatus    String?   @map("last_test_status") @db.VarChar(10) // ok/fail
  lastTestError     String?   @map("last_test_error") @db.VarChar(500)
  lastTestLatencyMs Int?      @map("last_test_latency_ms")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("publish_wechat_config")
}

/// 飞书工作台免登配置单例(M29 批①,plan M29):自建应用凭证;appSecret
/// write-only AES-256-GCM(secret-box,循 publish_wechat_config 同口径);
/// enabled=免登通道总开关(凭证齐+测试通过后再开)。
model AdminFeishuConfig {
  id                Int       @id @default(1) // 单例锚点,应用层只允许 id=1
  appId             String    @default("") @map("app_id") @db.VarChar(50) // cli_ 开头;空=未配置
  appSecretEnc      String?   @map("app_secret_enc") @db.VarChar(500) // base64(iv|tag|ct);null=未录
  appSecretMask     String?   @map("app_secret_mask") @db.VarChar(20) // 脱敏回显冗余列
  enabled           Boolean   @default(false) // 免登通道总开关
  lastTestedAt      DateTime? @map("last_tested_at") @db.Timestamptz(6)
  lastTestStatus    String?   @map("last_test_status") @db.VarChar(10) // ok/fail
  lastTestError     String?   @map("last_test_error") @db.VarChar(500)
  lastTestLatencyMs Int?      @map("last_test_latency_ms")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin_feishu_config")
}

/// 系统出口代理单例(M33 批B,plan M33):采集网关全部出站走家宽代理
/// (全局单点,用户定调);proxyUrl write-only AES-256-GCM(secret-box,
/// 循 admin_feishu_config 同口径),URL 只过境不回显;enabled=代理通道
/// 总开关(连通测试通过后再开)。网关零密钥不变:worker 解密后随请求携带。
model SystemProxyConfig {
  id                Int       @id @default(1) // 单例锚点,应用层只允许 id=1
  proxyUrlEnc       String?   @map("proxy_url_enc") @db.VarChar(500) // base64(iv|tag|ct);null=未录
  proxyUrlMask      String?   @map("proxy_url_mask") @db.VarChar(60) // 脱敏回显冗余列(scheme://host:port 形)
  enabled           Boolean   @default(false) // 代理通道总开关
  lastTestedAt      DateTime? @map("last_tested_at") @db.Timestamptz(6)
  lastTestStatus    String?   @map("last_test_status") @db.VarChar(10) // ok/fail
  lastTestError     String?   @map("last_test_error") @db.VarChar(500)
  lastTestLatencyMs Int?      @map("last_test_latency_ms")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_proxy_config")
}

/// admin 账号 ↔ 飞书身份绑定(M29 批①):免登白名单本体——fail-closed,
/// 仅本表 unionId 可静默兑换 admin 会话;无 DB 外键,应用层完整性
/// (userId 由 requireAdminRequest 会话锚定,unionId 由服务端兑换锚定)。
model AdminFeishuBinding {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @unique(map: "uq_admin_feishu_binding_user") @map("user_id") // 一账号一飞书身份
  unionId    String   @unique(map: "uq_admin_feishu_binding_union") @map("union_id") @db.VarChar(64) // 一飞书身份一账号
  openId     String   @map("open_id") @db.VarChar(64) // 应用内 openId(兑换回传,冗余留展示)
  feishuName String?  @map("feishu_name") @db.VarChar(100) // 兑换时姓名快照(审计友好)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin_feishu_binding")
}

/// 渠道分发状态(requirement §4 publish_channel;channel 字段渠道中立,
/// 一期仅 wechat,CSDN/知乎/掘金后置接入):每篇×渠道一行,(post,channel) 唯一。
/// media_id 有值重推走 draft/update,无值走 draft/add;title/digest/thumb_path
/// 为本次推送的微调快照(按渠道微调标题摘要封面)。文章软删级联删行。
model PublishChannel {
  id        BigInt    @id @default(autoincrement())
  postId    BigInt    @map("post_id")
  channel   String    @db.VarChar(20) // wechat(合法值应用层 Zod 管控,arch/03 枚举演进条款)
  status    String    @default("pending") @db.VarChar(20) // pending/synced/failed(应用层 Zod)
  mediaId   String?   @map("media_id") @db.VarChar(100) // 公众号草稿 media_id
  title     String?   @db.VarChar(500) // 推送标题快照(≤64 字,接口上限)
  digest    String?   @db.VarChar(500) // 摘要快照(≤120 字,接口上限)
  thumbPath String?   @map("thumb_path") @db.VarChar(500) // 封面快照(站内路径)
  theme     String?   @db.VarChar(20) // 正文主题快照(上次推送所用 id;空=渠道默认,重推沿用)
  attempts  Int       @default(0) @map("attempts") // 推送尝试次数(观测)
  lastError String?   @map("last_error") @db.VarChar(500)
  /// 渠道扩展数据(M49 批X1:xiaohongshu 起非微信渠道的渠道特有字段走此 JSON——
  /// xhs: noteUrl(发布回填)/materialPath(物料包)/coverPath(3:4 封面卡)等;
  /// wechat 既有类型化列保留不动(零搬迁零回归),新渠道禁再加渠道专名列)
  data      Json?
  syncedAt  DateTime? @map("synced_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, channel], map: "uq_publish_channel_post_channel")
  @@index([channel, status], map: "idx_publish_channel_channel_status")
  @@index([updatedAt(sort: Desc)], map: "idx_publish_channel_updated")
  @@map("publish_channel")
}

/// 渠道图片转存缓存(channel+source_key 唯一;防重推/更新草稿重复上传微信):
/// source_key 前缀区分锚与通道——b:<sha1(源字节)>=站内正文图(uploadimg)、
/// u:<sha1(url)>=外链正文图(uploadimg)、m:<sha1(源字节)>=封面(add_material,
/// remote_media_id 有值)。mmbiz 素材库 URL 永久有效,缓存无 TTL。
model PublishMediaCache {
  id            BigInt   @id @default(autoincrement())
  channel       String   @db.VarChar(20)
  sourceKey     String   @map("source_key") @db.VarChar(64) // b:/u:/m: 前缀 + sha1
  sourceUrl     String?  @map("source_url") @db.VarChar(1000) // 溯源(站内路径/原始外链)
  remoteUrl     String   @map("remote_url") @db.VarChar(1000) // https://mmbiz.qpic.cn/...
  remoteMediaId String?  @map("remote_media_id") @db.VarChar(100) // 仅 add_material 行
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([channel, sourceKey], map: "uq_publish_media_channel_key")
  @@map("publish_media_cache")
}

/// 搜索 Drawer 会话索引(K2.5,arch/04 §3):id 即 LangGraph thread_id(uuid),
/// 消息轨迹由 LangGraph checkpoint-postgres 表承载(框架 setup() 自管,不进
/// migrations——arch/03 边界);本表只做「线程列表 + 归属 + 30 天清退」锚点。
/// visitor 为匿名 cookie 身份(ah_av uuid);30 天未活跃由 worker 日清连
/// checkpoint 一起删。tokens_total 为 50k 护栏累计口径(usage_metadata 聚合)。
model SearchAgentSession {
  id            String   @id @db.VarChar(36)
  visitorId     String   @map("visitor_id") @db.VarChar(36)
  title         String?  @db.VarChar(40) // 首条用户消息前 20 字(run 收尾派生)
  tokensTotal   Int      @default(0) @map("tokens_total")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz(6)

  @@index([visitorId, lastMessageAt(sort: Desc)], map: "idx_search_agent_session_visitor_recent")
  @@index([lastMessageAt], map: "idx_search_agent_session_last_message")
  @@map("search_agent_session")
}

/// 用户 Token 钱包(M22 批①,免费额度制,用户拍板 2026-10-09):每账号一行,
/// userId 即主键;开户与月度重置均走读时惰性判定(periodKey≠当月则重置回
/// 月赠额并落 ledger,免 cron)。余额变更一律经 src/lib/users/token-balance.ts
/// 事务入口(行锁 FOR UPDATE 串行化,防并发扣穿);本表禁止散在直写。
model UserTokenWallet {
  userId    BigInt   @id @map("user_id")
  balance   Int      @default(0)
  periodKey String   @map("period_key") @db.Char(7) // "YYYY-MM" 北京月界(statsMonth 同源口径)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_token_wallet")
}

/// Token 流水(M22 批①,append-only 只增不改):grant=开户/月重置发放,
/// consume=会话 run 实扣(允许微穿仓,单轮护栏为下限),reset=上月余量回收,
/// adjust=admin 人工调整;balanceAfter 为本笔落账后余额快照(审计对账锚点)。
model UserTokenLedger {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  delta        Int // 正=入账 负=扣减
  balanceAfter Int      @map("balance_after")
  reason       String   @db.VarChar(16) // grant | consume | reset | adjust(应用层枚举)
  sessionId    String?  @map("session_id") @db.VarChar(40) // consume 溯源:agent 线程 id
  note         String?  @db.VarChar(200) // adjust 说明等
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_user_token_ledger_user_recent")
  @@map("user_token_ledger")
}

// ── feedback_(反馈域,M22 批①,需求7/9:联系我们→助手落库+admin 流转)──

/// 站点反馈:助手识别联系诉求后 submit_feedback 结构化落库(登录带 userId,
/// 游客仅 visitorId=ah_av 溯源);contact 用户自愿留(助手对话内询问,可拒)。
/// status 状态机 open → processing → resolved(应用层 Zod 管控,仿 pay 纪律);
/// sessionId 溯源 agent 线程;两归属列均无 FK,账号/游客过期不回删反馈。
model Feedback {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @map("user_id")
  visitorId String?  @map("visitor_id") @db.VarChar(36) // 游客 ah_av
  category  String   @db.VarChar(20) // requirement | issue | suggestion | other(应用层枚举)
  content   String   @db.VarChar(2000)
  contact   String?  @db.VarChar(200) // 用户自愿留的联系方式
  status    String   @default("open") @db.VarChar(16) // open | processing | resolved
  adminNote String?  @map("admin_note") @db.VarChar(500) // 处理备注
  sessionId String?  @map("session_id") @db.VarChar(40) // agent 线程溯源
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)], map: "idx_feedback_status_recent")
  @@map("feedback")
}

// ── discovery_(优质内容发现域,M25,方案锚 docs/plan/discovery-plan.md)──

/// 发现词库(任务A 联想词 + 人工种子):active 词是任务B 发现输入,
/// 新词 pending 经治理台确认后滚雪球闭环。word 落库即归一形(trim+lower),
/// 唯一约束与查重同一口径;origin/status 合法值应用层 Zod 管控。
model DiscoveryKeyword {
  id           BigInt             @id @default(autoincrement())
  word         String             @unique(map: "uq_discovery_keyword_word") @db.VarChar(100) // 归一形(trim+lower)
  origin       String             @db.VarChar(10) // manual | hotword
  status       String             @default("pending") @db.VarChar(10) // pending | active | dismissed | merged(并入已有词的别名)
  source       String?            @db.VarChar(30) // hotword 来源标识(如 bili-suggest/bing-suggest)
  mergedIntoId BigInt?            @map("merged_into_id") // 合并目标词(候选治理 F24;合并词命中统计随目标词)
  mergedInto   DiscoveryKeyword?  @relation("KeywordMergeTarget", fields: [mergedIntoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  mergedFrom   DiscoveryKeyword[] @relation("KeywordMergeTarget")
  firstSeenAt  DateTime           @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  confirmedAt  DateTime?          @map("confirmed_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([mergedIntoId], map: "idx_discovery_keyword_merged_into")
  @@map("discovery_keyword")
}

/// 发现候选(任务B 产物,L0 元数据预筛 + 治理台人工终审):
/// blogger=博主候选(治理台唯一系统出口,批准后人工至博主管理登记);
/// video=热点视频(治理台人工终审)。数据唯一真相源在本系统;外部分发
/// (如飞书选题库)不经系统内代码,后续经 MCP 接口由 Claude Code 打通。
/// upsert 幂等键 (type, platform, externalId);重复发现刷新统计与 round,
/// 不动 status(人工终审结论不回退)。
model DiscoveryCandidate {
  id           BigInt   @id @default(autoincrement())
  type         String   @db.VarChar(10) // blogger | video
  platform     String   @db.VarChar(20) // v1: bilibili
  externalId   String   @map("external_id") @db.VarChar(100) // B站 mid(博主)或 bvid(视频)
  round        String   @db.VarChar(8) // 发现批次 YYYYMMDD(Asia/Shanghai)
  title        String?  @db.VarChar(500) // video 标题;blogger 置空(样本见 sample_titles)
  author       String?  @db.VarChar(100)
  homepageUrl  String?  @map("homepage_url") @db.VarChar(500) // 博主主页/视频链接
  hitKeywords  Json?    @map("hit_keywords") // string[] 命中词(多词前排反复出现=强信号)
  hitCount     Int?     @map("hit_count")
  maxPlay      Int?     @map("max_play")
  totalPlay    Int?     @map("total_play")
  fans         Int? // card 接口补齐,失败可空(后续轮次或人工补)
  archives     Int? // card 接口补齐,失败可空
  sampleTitles Json?    @map("sample_titles") // string[] 标题样本前5
  l0Verdict    String   @map("l0_verdict") @db.VarChar(10) // pass | reject
  l0Reason     String?  @map("l0_reason") @db.VarChar(300) // 人话理由,治理台直读(如「名称命中营销特征词:学院」)
  status       String   @default("pending") @db.VarChar(10) // pending | approved | rejected
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([type, platform, externalId], map: "uq_discovery_candidate_identity")
  @@index([status, type], map: "idx_discovery_candidate_status_type")
  @@index([round], map: "idx_discovery_candidate_round")
  @@map("discovery_candidate")
}

// ── insight_(洞察中心域,M34,方案锚 docs/plan/insight-plan.md)──────────────
// 五介质痕迹模型(方案 §2):钱/时间/声音/搜索/AI 记录,真需求 ≥2 介质留痕。

/// 洞察信号(批① 只入内部零采集源:搜索词/agent 问句/评论/feedback/电报 AI
/// 产物;外部源批③④ 接入)。写侧唯一入口 lib/insight/ingest(fire-and-forget,
/// 幂等键 (source, ref_id) 撞唯一即跳过,回填与实时入池可并发)。domain 为
/// 跨域伏笔(远期 AI invest 财经打通/分布式爬虫多领域,方案 §1),批① 恒 tech。
/// embedding 批② 回填,读写 raw SQL(SearchEmbedding 同款,client 不暴露)。
model InsightSignal {
  id             BigInt                       @id @default(autoincrement())
  source         String                       @db.VarChar(30) // internal-search/internal-agent/internal-comment/internal-feedback/telegram-ai(批③起扩 hotboard-* 等)
  domain         String                       @default("tech") @db.VarChar(20) // tech | finance | ...(跨域伏笔;M54 起分类器落库,未分类=unclassified)
  subdomain      String?                      @map("subdomain") @db.VarChar(30) // tech 子域(M54:词表 key,如 ai-learning;域非 tech 时空)
  medium         String                       @db.VarChar(12) // money/time/voice/search/ai-record(五介质)
  refId          String                       @map("ref_id") @db.VarChar(120) // 溯源锚:源行 id 文本/会话 id(幂等键半)
  rawText        String                       @map("raw_text") @db.Text // 原文(截 4000)
  normalizedText String                       @map("normalized_text") @db.Text // 归一后(trim+空白折叠,截 2000;聚类/向量输入)
  meta           Json? // 源相关:{hitCount,postId,category,title,topic...}
  embedding      Unsupported("vector(1024)")? // 批② 回填;raw SQL 读写
  signalAt       DateTime                     @map("signal_at") @db.Timestamptz(6) // 信号发生时间(非采集时间)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  members InsightClusterMember[]

  @@unique([source, refId], map: "uq_insight_signal_source_ref")
  @@index([signalAt(sort: Desc)], map: "idx_insight_signal_recent")
  @@index([source, signalAt(sort: Desc)], map: "idx_insight_signal_source_recent")
  @@map("insight_signal")
}

/// 痛点/热点簇(批② 聚类产物):信号向量近邻归簇建簇,LLM 日批打标可读化。
/// media=留痕介质集合(机会评分卡输入,方案 §2;批②=成员介质并集,LLM 判定批③
/// 多介质外部源接入再收)。status 流转纪律:批② 仅 fading 兜底(14 天无新成员),
/// 阈值实测后定参(方案 §9-5)。labeledMemberCount=打标时成员数(增量重打标判定);
/// coverageScore/coverageState=内容覆盖度(日批对 post 向量近邻回写,看板直读免连查)。
model InsightCluster {
  id                 BigInt    @id @default(autoincrement())
  kind               String    @db.VarChar(8) // hot | pain
  sentiment          String?   @map("sentiment") @db.VarChar(8) // 舆情倾向(LLM 打标扩展位):positive|neutral|negative|mixed;null=未打标,读侧按中性显示
  domain             String    @default("tech") @db.VarChar(20) // 与 signal 同域聚类(跨域打通前不混簇)
  label              String?   @db.VarChar(200) // LLM 命名(人话;未打标 null)
  summary            String?   @db.VarChar(1000) // LLM 一句话概括
  keywords           Json? // string[]
  media              Json? // string[] 留痕介质集合
  score              Float? // 最新机会分
  labeledAt          DateTime? @map("labeled_at") @db.Timestamptz(6) // 最近 LLM 打标时间
  labeledMemberCount Int       @default(0) @map("labeled_member_count") // 打标时成员数
  coverageScore      Float?    @map("coverage_score") // 内容覆盖度 0-1(日批回写)
  coverageState      String?   @map("coverage_state") @db.VarChar(10) // covered | partial | blank
  status             String    @default("active") @db.VarChar(10) // active | fading | closed
  firstSeenAt        DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  peakAt             DateTime? @map("peak_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  members   InsightClusterMember[]
  snapshots InsightSnapshot[]

  @@index([kind, status], map: "idx_insight_cluster_kind_status")
  @@map("insight_cluster")
}

/// 簇-信号归属(同域 FK Cascade:信号/簇删除自动收尸,不靠应用层)
model InsightClusterMember {
  id        BigInt         @id @default(autoincrement())
  clusterId BigInt         @map("cluster_id")
  signalId  BigInt         @map("signal_id")
  weight    Float?
  cluster   InsightCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  signal    InsightSignal  @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([clusterId, signalId], map: "uq_insight_cluster_member")
  @@index([signalId], map: "idx_insight_cluster_member_signal")
  @@map("insight_cluster_member")
}

/// 簇每日快照(趋势 sparkline/异动告警输入,批② 写入)
model InsightSnapshot {
  id        BigInt         @id @default(autoincrement())
  clusterId BigInt         @map("cluster_id")
  date      DateTime       @db.Date
  score     Float
  rank      Int?
  cluster   InsightCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, date], map: "uq_insight_snapshot_cluster_date")
  @@map("insight_snapshot")
}

/// 热榜源登记(M34 批③ 验收反馈:纳入采集计划管理):fetcher 注册表(代码)
/// 的运行态投影——enabled=运行时启停闸(fetch 轮按表过滤,停用源不拉取),
/// lastRunAt/consecutiveFails/lastError 由 fetch 编排逐源回写(crawl_source
/// 同口径,连败可见)。缺行按启用处理:新 fetcher 上线免迁移即生效,台账读侧
/// 懒登记;启停只挡采集,不动 INSIGHT_SOURCES_ENABLED 读侧白名单。
model InsightHotSource {
  source           String    @id @db.VarChar(30) // hot-baidu/hot-zhihu/hot-bilibili(=InsightSource hot-*)
  enabled          Boolean   @default(true)
  consecutiveFails Int       @default(0) @map("consecutive_fails")
  lastRunAt        DateTime? @map("last_run_at") @db.Timestamptz(6)
  lastError        String?   @map("last_error") @db.VarChar(300)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("insight_hot_source")
}

/// 领域词表(M54:领域/子域两层 taxonomy)——分类器(Jev Choice)输出的合法
/// 键域与呈现层领域 chips 的唯一真相源。key=稳定标识(英文,分类器输出/查询
/// 过滤用,禁改);label=中文显示名;parent=子域所属领域 key(subdomain 行
/// 必填,domain 行空);enabled=停用后不参与分类与筛选(存量行保留)。
/// CRUD 走 /api/insight/taxonomy(会话鉴权);种子见迁移 20261028100000。
model InsightTaxonomy {
  id        Int      @id @default(autoincrement())
  kind      String   @db.VarChar(12) // domain | subdomain
  key       String   @unique @map("key") @db.VarChar(30)
  label     String   @map("label") @db.VarChar(30)
  parent    String?  @map("parent") @db.VarChar(30) // subdomain → 所属 domain key
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("insight_taxonomy")
}

// 专题内容管线(M26,docs/plan/topic-pipeline-plan.md §7):专题实体为内容
// 真相源(零飞书耦合),compose 初稿锚 content_post;itemId 应用层完整性
// (同 discovery 两表口径,无 FK)
model Topic {
  id             BigInt    @id @default(autoincrement())
  title          String    @db.VarChar(200)
  positioning    String?   @db.VarChar(1000) // 长文创作配置(四维条款文本,compose prompt 主输入)
  pinPositioning String?   @map("pin_positioning") @db.VarChar(1000) // 贴图创作配置(张数/比例/裁剪/风格条款文本;与 positioning 独立,互不派生)
  outputType     String    @default("article") @map("output_type") @db.VarChar(20) // article | pin:主意图(决定新建默认与 agent 分支,不限制另一种产出;应用层 Zod)
  status         String    @default("collecting") @db.VarChar(20) // collecting | drafted | published(合法值应用层 Zod,arch/03 枚举演进条款)
  skillKey       String?   @map("skill_key") @db.VarChar(50) // 绑定 agent_skill 的稳定引用(M30 批②;合成写稿按它取指南,soft ref 随 skill 删降级)
  linkedPostId   BigInt?   @map("linked_post_id") // 创作长文 content_post 锚(落稿时写,应用层完整性;一创作至多一篇)
  sampleImageId  BigInt?   @map("sample_image_id") // 样例参照图(writing_sample_image,soft ref 应用层完整性;M39 批③ 生图风格参照)
  composedAt     DateTime? @map("composed_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6) // 发布钩子回写
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  items TopicItem[]

  @@index([status, updatedAt(sort: Desc)], map: "idx_topic_status_updated")
  @@map("topic")
}

model TopicItem {
  id        BigInt   @id @default(autoincrement())
  topicId   BigInt   @map("topic_id")
  itemType  String   @map("item_type") @db.VarChar(20) // telegram | post(合法值应用层 Zod)
  itemId    BigInt   @map("item_id") // 应用层完整性:telegram.id / content_post.id
  note      String?  @db.VarChar(500) // 人工批注(compose 取舍指令)
  sortOrder Int      @default(0) @map("sort_order") // 合成时的叙事顺序
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, itemType, itemId], map: "uq_topic_item_identity")
  @@index([topicId, sortOrder], map: "idx_topic_item_topic_sort")
  @@map("topic_item")
}

/// 样例参照图库(M39 批③):管理员上传的风格参照图,绑到 topic.sample_image_id,
/// 合成生图(generate_illustration reference_path)时以 data URL 传 Seedream
/// `image` 参数,出图向参照风格靠拢。media_path 为媒体库站内路径
/// (/wp-content/uploads/…);文件归媒体库治理(sha1 去重、可能被正文引用),
/// 本表删行不删媒体;topic 引用为 soft ref(删行事务置空,应用层完整性)。
model WritingSampleImage {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(100) // 展示名(可重命名,默认取上传文件名去扩展)
  mediaPath String   @map("media_path") @db.VarChar(500) // 媒体库站内路径(uploadsUrlToRel 可逆)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("writing_sample_image")
}

/// Agent skill(M30 批①):业务流程纪律从 agent 系统提示提取为可管理资产——
/// 写作指南、分发流程等「知识型」扩展均落此表,后台建改即时生效零发版;
/// agent 经统一两工具渐进披露取用(批② 接线:list 元数据先行、get 按需全文)。
/// key 为 agent 侧/topic.skillKey 的稳定引用名;scenario 为适用场景(一行,
/// 供 agent 选 skill 对号);guideMd 为指南正文(markdown,可引用既有工具名);
/// 种子收编「博主×视频」指南 + 码点预算段(幂等 seed,不覆盖后台后续编辑)。
model AgentSkill {
  id        BigInt   @id @default(autoincrement())
  key       String   @unique(map: "uq_agent_skill_key") @db.VarChar(50)
  name      String   @db.VarChar(100)
  scenario  String   @db.VarChar(200) // 适用场景(供 agent/管理员选 skill 时对号)
  guideMd   String   @map("guide_md") @db.Text // 指南正文(markdown,流程纪律;机械执行归工具/管线)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("agent_skill")
}

/// 任务运行台账(验收二批③,学习 ai-invest collector_log):系统全部周期批任务
/// (cron 调度 + 手动触发,含 LLM/向量调用类)的持久运行记录——BullMQ
/// removeOnComplete 只留近几次,挂死/失败/耗时无处可查。单一写入口=worker
/// 分发器包装(worker/job-run#withJobRunLog):执行前先落 running 行(挂死
/// 立即可见),终态回写 summary/error。tick 类纯心跳(crawler/github/stats-flush
/// /pay-sweep)不落账——其工作单元在各自台账(crawl_source/github_repo)有账。
model JobRun {
  id         BigInt    @id @default(autoincrement())
  jobKey     String    @map("job_key") @db.VarChar(60) // 稳定键 queue/name(如 insight/fetch)
  queue      String    @db.VarChar(40)
  jobName    String    @map("job_name") @db.VarChar(60)
  trigger    String    @db.VarChar(10) // cron | manual(jobId 带 -manual- 前缀)
  status     String    @db.VarChar(10) // running | success | failed
  startedAt  DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs Int?      @map("duration_ms")
  summary    Json? // job 级汇总(处理器返回值;超长截断)
  error      String?   @db.Text // 失败信息(截 4000)

  @@index([startedAt(sort: Desc)], map: "idx_job_run_recent")
  @@index([jobKey, startedAt(sort: Desc)], map: "idx_job_run_key_recent")
  @@map("job_run")
}

/// 模型牌价(M55 工具钩子·价格速查页):官方一手牌价人工策展,三通道数据
/// (OpenRouter 预填/官方页爬虫/手工)均落 pending,enabled=终审可见。
/// 价格统一「货币 / 百万 tokens」口径;时段折扣与缓存价 v1 不收(note 提及)。
model ModelPricing {
  id            BigInt   @id @default(autoincrement())
  vendor        String   @db.VarChar(40) // 厂商(如 DeepSeek)
  modelKey      String   @db.VarChar(60) // 模型标识(如 deepseek-v3.2)
  currency      String   @default("CNY") @db.VarChar(8) // CNY | USD(国际原币直出)
  inputPrice    Decimal? @db.Decimal(12, 4) // 每百万 tokens;null=未公布(禁臆测)
  outputPrice   Decimal? @db.Decimal(12, 4)
  freeTier      String?  @db.VarChar(60) // 免费额度口径原文;null=「—」
  contextWindow String?  @db.VarChar(20) // 如 128K
  note          String?  @db.VarChar(200)
  dataAsOf      DateTime @map("data_as_of") @db.Timestamptz(6) // 数据截稿(页面横幅+行级溯源)
  sourceUrl     String   @db.VarChar(300) // 来源(官方牌价页)
  region        String   @default("cn") @db.VarChar(8) // cn | intl(页面分组)
  status        String   @default("pending") @db.VarChar(10) // pending | enabled | disabled
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([vendor, modelKey], map: "uq_model_pricing_vendor_model")
  @@index([status, region, sortOrder], map: "idx_model_pricing_page")
  @@map("model_pricing")
}

/// Coding Plan 订阅套餐(M55):额度口径各家不一,按官方原文呈现不强行归一;
/// 峰谷倍率原文直出(如「峰 1× · 谷 0.5×」),字段拆存便于页面分列。
model CodingPlan {
  id          BigInt   @id @default(autoincrement())
  vendor      String   @db.VarChar(40)
  planName    String   @db.VarChar(60) // 套餐名(如 GLM Coding Plan · Lite)
  currency    String   @default("CNY") @db.VarChar(8)
  monthlyFee  Decimal? @db.Decimal(12, 2) // null=未公布
  quotaDesc   String   @db.VarChar(200) // 额度口径原文(口径不归一)
  peakRate    String?  @db.VarChar(60) // 高峰倍率原文(如 峰 1×)
  offPeakRate String?  @db.VarChar(60) // 闲时倍率原文(如 谷 0.5×)
  bestFor     String?  @db.VarChar(80) // 适合人群
  dataAsOf    DateTime @map("data_as_of") @db.Timestamptz(6)
  sourceUrl   String   @db.VarChar(300)
  status      String   @default("pending") @db.VarChar(10) // pending | enabled | disabled
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([vendor, planName], map: "uq_coding_plan_vendor_plan")
  @@index([status, sortOrder], map: "idx_coding_plan_page")
  @@map("coding_plan")
}
